{
  "version": 2,
  "name": "lyan-app",
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "echo 'Static site deployment ready'",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.lyann.app"
        }
      ],
      "destination": "/admin.html",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "admin.lyann.app"
        }
      ],
      "destination": "/admin.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
