{
  "version": 2,
  "name": "lyan-app",
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "echo 'Static site deployment ready'",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/((?!.*\\.(?:css|js|png|jpg|jpeg|gif|svg|ico|json|woff2?)).*)",
      "has": [
        {
          "type": "host",
          "value": "admin.lyann.app"
        }
      ],
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
