# ===========================================
# LYANN DOM — Configuration Environnement
# ===========================================
# Copiez ce fichier en ".env" et remplissez les valeurs

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PLATFORM_COMMISSION_RATE=0.035

# --- Supabase (Service Role - Backend uniquement) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...your_service_key_here

# --- SendGrid (Emails) ---
SENDGRID_API_KEY=SG.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SENDGRID_SENDER_EMAIL=no-reply@lyann-dom.com

# --- Twilio (SMS) ---
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+15005550006

# --- Playwright QA (tests only — never ship these in the Web/iOS bundle) ---
# Place real values in `.env.local` (gitignored). Playwright loads that file automatically.
LYANN_E2E_QA_A_EMAIL=
LYANN_E2E_QA_A_PASSWORD=
LYANN_E2E_QA_B_EMAIL=
LYANN_E2E_QA_B_PASSWORD=
LYANN_E2E_ALLOW_WRITES=false
# Isolated QA writes: never the production project ref gzispjfoywklpqatjyop.
LYANN_E2E_WRITE_PROJECT_REF=
LYANN_SUPABASE_URL=
LYANN_SUPABASE_ANON_KEY=

# Public Stripe key may live in the client. The secret must not.
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXX
