{
  "appId": "app.lyann.mobile",
  "appName": "LYANN",
  "webDir": "www",
  "backgroundColor": "#FAF7F2",
  "ios": {
    "backgroundColor": "#FAF7F2"
  },
  "android": {
    "backgroundColor": "#FDFCF9"
  },
  "server": {
    "allowNavigation": [
      "*.stripe.com",
      "*.stripe.network",
      "js.stripe.com"
    ]
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "PushNotifications": {
      "presentationOptions": ["banner", "list", "badge", "sound"]
    },
    "Keyboard": {
      "resizeOnFullScreen": true
    }
  }
}
